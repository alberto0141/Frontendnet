@model IEnumerable<Bitacora>

@{
    ViewData["Title"] = "Bitácora";
    ViewData["SubTitle"] = "Listado";

    var registros = Model?.ToList() ?? [];

    static string SafeText(string? value, int maxLength = 120)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "No disponible";
        }

        var normalizedValue = value.Trim();

        return normalizedValue.Length > maxLength
            ? $"{normalizedValue[..maxLength]}..."
            : normalizedValue;
    }

    static string FormatDate(DateTime? value)
    {
        return value.HasValue
            ? value.Value.ToString("dd/MM/yyyy HH:mm:ss")
            : "No disponible";
    }
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item active" aria-current="page">
            @ViewData["SubTitle"]
        </li>
    </ol>
</nav>

<h2 class="text-center mb-3">
    @ViewData["Title"]
    <small class="text-muted fs-5">@ViewData["SubTitle"]</small>
</h2>

<div class="row small mb-3">
    <div class="col text-end">
        Mostrando @registros.Count elementos
    </div>
</div>

@if (registros.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle small">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Acción</th>
                    <th scope="col">Elemento Id</th>
                    <th scope="col">IP</th>
                    <th scope="col">Usuario</th>
                    <th scope="col">Fecha</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in registros)
                {
                    <tr>
                        <td>
                            @(item.BitacoraId?.ToString() ?? "No disponible")
                        </td>

                        <td title="@SafeText(item.Accion, 500)">
                            @SafeText(item.Accion)
                        </td>

                        <td title="@SafeText(item.ElementoId, 500)">
                            @SafeText(item.ElementoId)
                        </td>

                        <td title="@SafeText(item.IP, 100)">
                            @SafeText(item.IP, 45)
                        </td>

                        <td title="@SafeText(item.Usuario, 500)">
                            @SafeText(item.Usuario)
                        </td>

                        <td>
                            @FormatDate(item.Fecha)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        No se encontraron elementos. Inténtelo de nuevo más tarde.
    </div>
}