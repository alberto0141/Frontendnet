@model IEnumerable<Usuario>

@{
    ViewData["Title"] = "Usuarios";
    ViewData["SubTitle"] = "Listado";

    var usuarios = Model?.Where(usuario => usuario is not null).ToList() ?? [];

    static string SafeText(string? value, int maxLength = 120)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "No disponible";
        }

        var normalizedValue = value.Trim();

        return normalizedValue.Length > maxLength
            ? $"{normalizedValue[..maxLength]}..."
            : normalizedValue;
    }

    static bool HasValidEmail(string? email)
    {
        return !string.IsNullOrWhiteSpace(email) && email.Contains('@', StringComparison.Ordinal);
    }
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item active" aria-current="page">
            @ViewData["SubTitle"]
        </li>
    </ol>
</nav>

<h2 class="text-center mb-3">
    @ViewData["Title"]
    <small class="text-muted fs-5">@ViewData["SubTitle"]</small>
</h2>

<div class="text-end mb-3">
    <a class="btn btn-sm btn-primary"
       asp-action="Crear"
       title="Crear nuevo usuario">
        Crear nuevo
    </a>
</div>

<div class="row small mb-3">
    <div class="col text-end">
        Mostrando @usuarios.Count elementos
    </div>
</div>

@if (usuarios.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th scope="col">
                        Id
                    </th>
                    <th scope="col">
                        Email
                    </th>
                    <th scope="col">
                        Nombre
                    </th>
                    <th scope="col">
                        Rol
                    </th>
                    <th scope="col" class="text-center">
                        Acciones
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in usuarios)
                {
                    var email = string.IsNullOrWhiteSpace(item.Email)
                        ? string.Empty
                        : item.Email.Trim().ToLowerInvariant();

                    var hasValidEmail = HasValidEmail(email);
                    var isCurrentUser = string.Equals(User.Identity?.Name, email, StringComparison.OrdinalIgnoreCase);

                    <tr>
                        <td title="@SafeText(item.Id, 500)">
                            @SafeText(item.Id, 80)
                        </td>

                        <td title="@SafeText(item.Email, 500)">
                            @SafeText(item.Email, 120)
                        </td>

                        <td title="@SafeText(item.Nombre, 500)">
                            @SafeText(item.Nombre, 120)
                        </td>

                        <td title="@SafeText(item.Rol, 500)">
                            @SafeText(item.Rol, 80)
                        </td>

                        <td class="text-center">
                            @if (hasValidEmail)
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-action="Detalle"
                                   asp-route-id="@email"
                                   title="Ver detalle">
                                    Detalle
                                </a>

                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Editar"
                                   asp-route-id="@email"
                                   title="Editar usuario">
                                    Editar
                                </a>

                                @if (isCurrentUser)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            disabled
                                            title="No puede eliminar la cuenta actual">
                                        Sesión actual
                                    </button>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-danger"
                                       asp-action="Eliminar"
                                       asp-route-id="@email"
                                       title="Eliminar usuario">
                                        Eliminar
                                    </a>
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    Sin acciones
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        No se encontraron elementos. Inténtelo de nuevo más tarde.
    </div>
}