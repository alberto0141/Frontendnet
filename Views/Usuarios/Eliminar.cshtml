@model Usuario

@{
    ViewData["Title"] = "Usuarios";
    ViewData["SubTitle"] = "Eliminar";

    var email = string.IsNullOrWhiteSpace(Model?.Email)
        ? string.Empty
        : Model.Email.Trim().ToLowerInvariant();

    var hasValidModel = Model is not null &&
                        !string.IsNullOrWhiteSpace(email) &&
                        !string.IsNullOrWhiteSpace(Model.Nombre) &&
                        !string.IsNullOrWhiteSpace(Model.Rol);

    var errorMessage = Convert.ToString(ViewData["ErrorMessage"]);

    var puedeEditar = ViewBag.PuedeEditar is not bool value || value;
    var isCurrentUser = string.Equals(User.Identity?.Name, email, StringComparison.OrdinalIgnoreCase);
}

<partial name="_PageHeaderPartial" />

@if (!hasValidModel)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar la información del usuario.
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}
else if (!puedeEditar || isCurrentUser)
{
    <div class="alert alert-warning" role="alert">
        No puede eliminar la cuenta con la que inició sesión.
    </div>

    <partial name="_DetallePartial" model="Model" />

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}
else
{
    <div class="alert alert-danger" role="alert">
        ¿Está seguro de que desea eliminar este usuario?
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-warning" role="alert">
            @errorMessage
        </div>
    }

    <partial name="_DetallePartial" model="Model" />

    <form asp-action="Eliminar"
          asp-route-id="@email"
          method="post"
          autocomplete="off">
        @Html.AntiForgeryToken()

        <div class="text-center mt-3">
            <button id="btnEnviar"
                    type="submit"
                    class="btn btn-sm btn-danger">
                Eliminar
            </button>

            <a class="btn btn-sm btn-outline-secondary"
               asp-action="Index"
               title="Cancelar">
                Cancelar
            </a>
        </div>
    </form>
}