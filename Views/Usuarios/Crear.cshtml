@model UsuarioPwd

@{
    ViewData["Title"] = "Usuarios";
    ViewData["SubTitle"] = "Crear";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<partial name="_PageHeaderPartial" />

<form asp-action="Crear"
      method="post"
      autocomplete="off">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="card mt-3">
        <div class="card-body small">
            <div class="form-floating mb-3">
                <input asp-for="Email"
                       id="Email"
                       type="email"
                       placeholder="Correo electrónico"
                       class="form-control"
                       autocomplete="username"
                       maxlength="254"
                       aria-describedby="emailHelp" />

                <label for="Email" class="form-label">
                    @Html.DisplayNameFor(model => model.Email)
                </label>

                <span asp-validation-for="Email" class="text-danger"></span>

                <div id="emailHelp" class="form-text small">
                    Ingrese un correo electrónico válido.
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Nombre"
                       id="Nombre"
                       type="text"
                       placeholder="Nombre"
                       class="form-control"
                       maxlength="120"
                       autocomplete="name"
                       aria-describedby="nombreHelp" />

                <label for="Nombre" class="form-label">
                    @Html.DisplayNameFor(model => model.Nombre)
                </label>

                <span asp-validation-for="Nombre" class="text-danger"></span>

                <div id="nombreHelp" class="form-text small">
                    Ingrese el nombre del usuario.
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Password"
                       id="Password"
                       type="password"
                       placeholder="Contraseña"
                       class="form-control"
                       autocomplete="new-password"
                       maxlength="128"
                       aria-describedby="passwordHelp" />

                <label for="Password" class="form-label">
                    @Html.DisplayNameFor(model => model.Password)
                </label>

                <span asp-validation-for="Password" class="text-danger"></span>

                <div id="passwordHelp" class="form-text small">
                    Use una contraseña segura.
                </div>
            </div>

            <div class="form-floating mb-3">
                <select asp-for="Rol"
                        id="Rol"
                        asp-items="ViewBag.Rol"
                        class="form-select"
                        aria-describedby="rolHelp">
                    <option value="">Seleccione un rol</option>
                </select>

                <label for="Rol" class="form-label">
                    @Html.DisplayNameFor(model => model.Rol)
                </label>

                <span asp-validation-for="Rol" class="text-danger"></span>

                <div id="rolHelp" class="form-text small">
                    Seleccione el rol que tendrá el usuario.
                </div>
            </div>
        </div>
    </div>

    <partial name="_SaveCancelPartial" />
</form>
