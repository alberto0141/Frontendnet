@model Usuario

@{
    ViewData["Title"] = "Usuarios";
    ViewData["SubTitle"] = "Detalle";

    var hasValidModel = Model is not null &&
                        !string.IsNullOrWhiteSpace(Model.Email) &&
                        !string.IsNullOrWhiteSpace(Model.Nombre) &&
                        !string.IsNullOrWhiteSpace(Model.Rol);
}

<partial name="_PageHeaderPartial" />

@if (!hasValidModel)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar la información del usuario.
    </div>
}
else
{
    <partial name="_DetallePartial" model="Model" />
}

<div class="text-center mt-3">
    <a class="btn btn-sm btn-outline-secondary"
       asp-action="Index"
       title="Cancelar">
        Cancelar
    </a>
</div>