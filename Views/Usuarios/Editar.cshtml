@model Usuario

@{
    ViewData["Title"] = "Usuarios";
    ViewData["SubTitle"] = "Editar";

    var hasValidModel = Model is not null &&
                        !string.IsNullOrWhiteSpace(Model.Email) &&
                        !string.IsNullOrWhiteSpace(Model.Nombre) &&
                        !string.IsNullOrWhiteSpace(Model.Rol);

    var email = string.IsNullOrWhiteSpace(Model?.Email)
        ? string.Empty
        : Model.Email.Trim().ToLowerInvariant();

    var nombre = string.IsNullOrWhiteSpace(Model?.Nombre)
        ? string.Empty
        : Model.Nombre.Trim();

    var rol = string.IsNullOrWhiteSpace(Model?.Rol)
        ? string.Empty
        : Model.Rol.Trim();

    var puedeEditar = ViewBag.PuedeEditar is not bool value || value;
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<partial name="_PageHeaderPartial" />

@if (!hasValidModel)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar la información del usuario.
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}
else
{
    @if (!puedeEditar)
    {
        <div class="alert alert-warning" role="alert">
            Está editando su propia cuenta. Revise con cuidado los cambios de rol.
        </div>
    }

    <form asp-action="Editar"
          asp-route-id="@email"
          method="post"
          autocomplete="off">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="card mt-3">
            <div class="card-body small">
                <div class="form-floating mb-3">
                    <input asp-for="Email"
                           id="Email"
                           value="@email"
                           type="email"
                           placeholder="Correo electrónico"
                           readonly
                           class="form-control-plaintext"
                           autocomplete="username"
                           maxlength="254"
                           aria-describedby="emailHelp" />

                    <label for="Email" class="form-label">
                        @Html.DisplayNameFor(model => model.Email)
                    </label>

                    <span asp-validation-for="Email" class="text-danger"></span>

                    <div id="emailHelp" class="form-text small">
                        El correo electrónico identifica al usuario y no debe modificarse desde esta vista.
                    </div>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Nombre"
                           id="Nombre"
                           value="@nombre"
                           type="text"
                           placeholder="Nombre"
                           class="form-control"
                           autocomplete="name"
                           maxlength="120"
                           aria-describedby="nombreHelp" />

                    <label for="Nombre" class="form-label">
                        @Html.DisplayNameFor(model => model.Nombre)
                    </label>

                    <span asp-validation-for="Nombre" class="text-danger"></span>

                    <div id="nombreHelp" class="form-text small">
                        Ingrese el nombre del usuario.
                    </div>
                </div>

                <div class="form-floating mb-3">
                    <select asp-for="Rol"
                            id="Rol"
                            asp-items="ViewBag.Rol"
                            class="form-select"
                            aria-describedby="rolHelp">
                        <option value="">Seleccione un rol</option>
                    </select>

                    <label for="Rol" class="form-label">
                        @Html.DisplayNameFor(model => model.Rol)
                    </label>

                    <span asp-validation-for="Rol" class="text-danger"></span>

                    <div id="rolHelp" class="form-text small">
                        Seleccione el rol asignado al usuario.
                    </div>
                </div>
            </div>
        </div>

        <partial name="_SaveCancelPartial" />
    </form>
}