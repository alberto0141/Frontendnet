@using frontendnet.Models.Validation
@model Categoria

@{
    ViewData["Title"] = "Categorías";
    ViewData["SubTitle"] = "Crear";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<partial name="_PageHeaderPartial" />

<form asp-action="Crear"
      method="post"
      autocomplete="off">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="card mt-3">
        <div class="card-body small">
            <div class="form-floating mb-3">
                <input asp-for="Nombre"
                       id="Nombre"
                       type="text"
                       placeholder="Nombre"
                       class="form-control"
                       maxlength="@CategoryValidation.NameMaxLength"
                       aria-describedby="nombreHelp" />

                <label for="Nombre" class="form-label">
                    @Html.DisplayNameFor(model => model.Nombre)
                </label>

                <span asp-validation-for="Nombre" class="text-danger"></span>

                <div id="nombreHelp" class="form-text small">
                    Ingrese un nombre válido para la categoría.
                </div>
            </div>
        </div>
    </div>

    <partial name="_SaveCancelPartial" />
</form>
