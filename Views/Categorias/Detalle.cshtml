@model Categoria

@{
    ViewData["Title"] = "Categorías";
    ViewData["SubTitle"] = "Detalle";

    var hasValidModel = Model is not null && Model.CategoriaId.HasValue && Model.CategoriaId.Value > 0;
}

<partial name="_PageHeaderPartial" />

@if (!hasValidModel)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar la información de la categoría.
    </div>
}
else
{
    <partial name="_DetallePartial" model="Model" />
}

<div class="text-center mt-3">
    <a class="btn btn-sm btn-outline-secondary"
       asp-action="Index"
       title="Cancelar">
        Cancelar
    </a>
</div>