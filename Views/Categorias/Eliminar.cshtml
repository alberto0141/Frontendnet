@model Categoria

@{
    ViewData["Title"] = "Categorías";
    ViewData["SubTitle"] = "Eliminar";

    var hasValidModel = Model is not null && Model.CategoriaId.HasValue && Model.CategoriaId.Value > 0;
    var errorMessage = Convert.ToString(ViewData["ErrorMessage"]);
}

<partial name="_PageHeaderPartial" />

@if (!hasValidModel)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar la información de la categoría.
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}
else if (Model!.Protegida)
{
    <div class="alert alert-warning" role="alert">
        La categoría <strong>@Model.Nombre</strong> está protegida y no puede eliminarse.
    </div>

    <partial name="_DetallePartial" model="Model" />

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}
else
{
    <div class="alert alert-danger" role="alert">
        ¿Está seguro de que desea eliminar este elemento?
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-warning" role="alert">
            @errorMessage
        </div>
    }

    <partial name="_DetallePartial" model="Model" />

    <form asp-action="Eliminar"
          asp-route-id="@Model.CategoriaId!.Value"
          method="post"
          autocomplete="off">
        @Html.AntiForgeryToken()

        <div class="text-center mt-3">
            <button id="btnEnviar"
                    type="submit"
                    class="btn btn-sm btn-danger">
                Eliminar
            </button>

            <a class="btn btn-sm btn-outline-secondary"
               asp-action="Index"
               title="Cancelar">
                Cancelar
            </a>
        </div>
    </form>
}