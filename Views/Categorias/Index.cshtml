@model IEnumerable<Categoria>

@{
    ViewData["Title"] = "Categorías";
    ViewData["SubTitle"] = "Listado";

    var categorias = Model?.ToList() ?? [];

    static string SafeText(string? value, int maxLength = 120)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "No disponible";
        }

        var normalizedValue = value.Trim();

        return normalizedValue.Length > maxLength
            ? $"{normalizedValue[..maxLength]}..."
            : normalizedValue;
    }
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item active" aria-current="page">
            @ViewData["SubTitle"]
        </li>
    </ol>
</nav>

<h2 class="text-center mb-3">
    @ViewData["Title"]
    <small class="text-muted fs-5">@ViewData["SubTitle"]</small>
</h2>

<div class="text-end mb-3">
    <a class="btn btn-sm btn-primary"
       asp-action="Crear"
       title="Crear nueva categoría">
        Crear nueva
    </a>
</div>

<div class="row small mb-3">
    <div class="col text-end">
        Mostrando @categorias.Count elementos
    </div>
</div>

@if (categorias.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th scope="col">
                        Id
                    </th>
                    <th scope="col">
                        Nombre
                    </th>
                    <th scope="col">
                        Protegida
                    </th>
                    <th scope="col" class="text-center">
                        Acciones
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in categorias)
                {
                    var hasValidId = item.CategoriaId.HasValue && item.CategoriaId.Value > 0;
                    var nombre = SafeText(item.Nombre);

                    <tr>
                        <td>
                            @(hasValidId ? item.CategoriaId!.Value.ToString() : "No disponible")
                        </td>

                        <td title="@SafeText(item.Nombre, 500)">
                            @nombre
                        </td>

                        <td>
                            @if (item.Protegida)
                            {
                                <span class="badge text-bg-warning">
                                    Sí
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">
                                    No
                                </span>
                            }
                        </td>

                        <td class="text-center">
                            @if (hasValidId)
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-action="Detalle"
                                   asp-route-id="@item.CategoriaId"
                                   title="Ver detalle">
                                    Detalle
                                </a>

                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Editar"
                                   asp-route-id="@item.CategoriaId"
                                   title="Editar categoría">
                                    Editar
                                </a>

                                @if (!item.Protegida)
                                {
                                    <a class="btn btn-sm btn-outline-danger"
                                       asp-action="Eliminar"
                                       asp-route-id="@item.CategoriaId"
                                       title="Eliminar categoría">
                                        Eliminar
                                    </a>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            disabled
                                            title="Categoría protegida">
                                        Protegida
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    Sin acciones
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        No se encontraron elementos. Inténtelo de nuevo más tarde.
    </div>
}