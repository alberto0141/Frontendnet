@model Login

@{
    ViewData["Title"] = "Inicio de sesión";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success mx-auto login-card mb-3" role="alert">
        @successMessage
    </div>
}

<form asp-action="Index"
      method="post"
      autocomplete="off">
    @Html.AntiForgeryToken()

    <div class="card mx-auto login-card">
        <div class="card-body">
            <h1 class="h3 text-center">Bienvenido a Mercado Libre</h1>
            <h2 class="h6 text-center text-muted">Facultad de Estadística e Informática</h2>
            <h3 class="card-title text-center mt-4">@ViewData["Title"]</h3>

            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email"
                       id="Email"
                       type="email"
                       class="form-control"
                       placeholder="Correo electrónico"
                       autocomplete="username"
                       maxlength="254"
                       aria-describedby="emailHelp" />

                <label for="Email" class="form-label">
                    @Html.DisplayNameFor(model => model.Email)
                </label>

                <span asp-validation-for="Email" class="text-danger"></span>

                <div id="emailHelp" class="form-text small">
                    Ingrese el correo electrónico registrado.
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Password"
                       id="Password"
                       type="password"
                       class="form-control"
                       placeholder="Contraseña"
                       autocomplete="current-password"
                       maxlength="128"
                       aria-describedby="passwordHelp" />

                <label for="Password" class="form-label">
                    @Html.DisplayNameFor(model => model.Password)
                </label>

                <span asp-validation-for="Password" class="text-danger"></span>

                <div id="passwordHelp" class="form-text small">
                    No comparta su contraseña con nadie.
                </div>
            </div>

            <p class="card-text small">
                Ingrese sus credenciales para acceder al contenido de la plataforma.
            </p>

            <p class="card-text small text-end">
                <a asp-controller="Auth"
                   asp-action="Registro"
                   class="link-primary text-decoration-none">
                    Crear cuenta
                </a>
            </p>
        </div>

        <div class="card-footer text-center">
            <button type="submit" class="btn btn-primary">
                Iniciar sesión
            </button>
        </div>
    </div>
</form>