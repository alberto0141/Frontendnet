@model Producto

@{
    var hasValidProduct = Model is not null && Model.ProductoId > 0;
}

@if (hasValidProduct)
{
    <div class="card h-100">
        @await Html.PartialAsync("~/Views/Shared/_ProductCardContent.cshtml", Model,
            new ViewDataDictionary(ViewData) { ["ImgClass"] = "carrito-card-img", ["ShowDescription"] = false })

        <div class="card-footer text-center">
            <button type="button"
                    class="btn btn-sm btn-secondary"
                    disabled>
                Pendiente de compra
            </button>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar este producto.
    </div>
}
