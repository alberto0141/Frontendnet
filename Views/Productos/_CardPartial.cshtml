@using frontendnet.Security
@model Producto

@{
    static string SafeText(string? value, int maxLength = 120)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "No disponible";
        }

        var normalizedValue = value.Trim();

        return normalizedValue.Length > maxLength
            ? $"{normalizedValue[..maxLength]}..."
            : normalizedValue;
    }

    var hasValidProduct = Model is not null && Model.ProductoId > 0;
    var hasValidFile = Model?.ArchivoId is > 0;

    var title = SafeText(Model?.Titulo);
    var description = SafeText(Model?.Descripcion, 160);

    var price = Model?.Precio is > 0
        ? Model.Precio.ToString("C")
        : "No disponible";

    var configuredUrl = Convert.ToString(ViewBag.Url);
    Uri? baseUri = null;
    var hasValidBaseUrl = Uri.TryCreate(configuredUrl, UriKind.Absolute, out baseUri);

    var imageUrl = hasValidFile && hasValidBaseUrl
        ? $"{baseUri!.ToString().TrimEnd('/')}/api/archivos/{Model!.ArchivoId}"
        : Url.Content("~/images/logo.png");

    var categories = Model?.Categorias ?? [];
    var isAdministrator = User.IsInRole(AppRoles.Administrator);
}

@if (hasValidProduct)
{
    <div class="card h-100">
        <img src="@imageUrl"
             alt="@title"
             class="card-img-top producto-card-img"
             loading="lazy"
             decoding="async">

        <div class="card-body d-flex flex-column">
            <p class="card-text fw-semibold" title="@SafeText(Model?.Titulo, 500)">
                @title
            </p>

            <p class="card-text small text-muted" title="@SafeText(Model?.Descripcion, 500)">
                @description
            </p>

            <h5 class="card-title">
                @price
            </h5>

            @if (categories.Any())
            {
                <p class="card-text">
                    @foreach (var category in categories)
                    {
                        var categoryName = SafeText(category.Nombre, 50);

                        <span class="badge rounded-pill text-bg-warning me-1">
                            @categoryName
                        </span>
                    }
                </p>
            }

            <p class="mt-auto card-text text-success fw-semibold small">
                <i class="bi bi-lightning-fill" aria-hidden="true"></i>
                Envío gratis
            </p>
        </div>

        <div class="card-footer text-center">
            <a class="btn btn-sm btn-outline-secondary"
               asp-action="Detalle"
               asp-route-id="@Model!.ProductoId"
               title="Ver detalle">
                Detalle
            </a>

            @if (isAdministrator)
            {
                <a class="btn btn-sm btn-outline-primary"
                   asp-action="Editar"
                   asp-route-id="@Model.ProductoId"
                   title="Editar producto">
                    Editar
                </a>

                <a class="btn btn-sm btn-outline-warning"
                   asp-action="Categorias"
                   asp-route-id="@Model.ProductoId"
                   title="Administrar categorías">
                    Categorías
                </a>

                <a class="btn btn-sm btn-outline-danger"
                   asp-action="Eliminar"
                   asp-route-id="@Model.ProductoId"
                   title="Eliminar producto">
                    Eliminar
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar este producto.
    </div>
}