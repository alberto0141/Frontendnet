@using frontendnet.Security
@model Producto

@{
    var hasValidProduct = Model is not null && Model.ProductoId > 0;
    var isAdministrator = User.IsInRole(AppRoles.Administrator);
}

@if (hasValidProduct)
{
    <div class="card h-100">
        @await Html.PartialAsync("~/Views/Shared/_ProductCardContent.cshtml", Model,
            new ViewDataDictionary(ViewData) { ["ImgClass"] = "producto-card-img" })

        <div class="card-footer text-center">
            <a class="btn btn-sm btn-outline-secondary"
               asp-action="Detalle"
               asp-route-id="@Model!.ProductoId"
               title="Ver detalle">
                Detalle
            </a>

            @if (isAdministrator)
            {
                <a class="btn btn-sm btn-outline-primary"
                   asp-action="Editar"
                   asp-route-id="@Model.ProductoId"
                   title="Editar producto">
                    Editar
                </a>

                <a class="btn btn-sm btn-outline-warning"
                   asp-action="Categorias"
                   asp-route-id="@Model.ProductoId"
                   title="Administrar categorías">
                    Categorías
                </a>

                <a class="btn btn-sm btn-outline-danger"
                   asp-action="Eliminar"
                   asp-route-id="@Model.ProductoId"
                   title="Eliminar producto">
                    Eliminar
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar este producto.
    </div>
}
