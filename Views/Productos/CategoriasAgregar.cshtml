@model ProductoCategoria

@{
    ViewData["Title"] = "Productos";
    ViewData["SubTitle"] = "Agregar categoría";

    var hasValidProduct = Model?.Producto is not null && Model.Producto.ProductoId > 0;
    var productoId = hasValidProduct ? Model!.Producto!.ProductoId : 0;

    var productTitle = string.IsNullOrWhiteSpace(Model?.Producto?.Titulo)
        ? "Producto no disponible"
        : Model.Producto.Titulo.Trim();
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item">
            <a class="text-decoration-none"
               title="Regresar al listado"
               asp-action="Index">
                Listado
            </a>
        </li>
        <li class="breadcrumb-item">
            @if (hasValidProduct)
            {
                <a class="text-decoration-none"
                   title="Regresar a categorías"
                   asp-action="Categorias"
                   asp-route-id="@productoId">
                    Categorías
                </a>
            }
            else
            {
                <span>Categorías</span>
            }
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            @ViewData["SubTitle"]
        </li>
    </ol>
</nav>

<h2 class="text-center mb-3">
    @ViewData["Title"]
    <small class="text-muted fs-5">@ViewData["SubTitle"]</small>
</h2>

@if (!hasValidProduct)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar la información del producto.
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}
else
{
    <div class="card mt-3">
        <div class="card-body small">
            <h3 class="h6 mb-0">
                Producto:
                <span class="fw-semibold">@productTitle</span>
            </h3>
        </div>
    </div>

    <form asp-action="CategoriasAgregar"
          asp-route-id="@productoId"
          method="post"
          autocomplete="off">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="card mt-3">
            <div class="card-body small">
                <div class="form-floating mb-3">
                    <select asp-for="CategoriaId"
                            id="CategoriaId"
                            asp-items="ViewBag.Categoria"
                            class="form-select"
                            aria-describedby="categoriaHelp">
                        <option value="">Seleccione una categoría</option>
                    </select>

                    <label for="CategoriaId" class="form-label">
                        @Html.DisplayNameFor(model => model.CategoriaId)
                    </label>

                    <span asp-validation-for="CategoriaId" class="text-danger"></span>

                    <div id="categoriaHelp" class="form-text small">
                        Seleccione la categoría que desea asignar al producto.
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-3">
            <button id="btnEnviar"
                    type="submit"
                    class="btn btn-sm btn-primary">
                Guardar
            </button>

            <a class="btn btn-sm btn-outline-secondary"
               asp-action="Categorias"
               asp-route-id="@productoId"
               title="Cancelar">
                Cancelar
            </a>
        </div>
    </form>
}