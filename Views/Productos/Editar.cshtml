@model Producto

@{
    ViewData["Title"] = "Productos";
    ViewData["SubTitle"] = "Editar";

    var hasValidProduct = Model is not null && Model.ProductoId > 0;
    var productoId = hasValidProduct ? Model!.ProductoId : 0;

    var configuredUrl = Convert.ToString(ViewBag.Url);
    Uri? baseUri = null;
    var hasValidBaseUrl = Uri.TryCreate(configuredUrl, UriKind.Absolute, out baseUri);

    var hasValidFile = Model?.ArchivoId is > 0;

    var productTitle = string.IsNullOrWhiteSpace(Model?.Titulo)
        ? "Producto actual"
        : Model.Titulo.Trim();

    var imageUrl = hasValidProduct && hasValidFile && hasValidBaseUrl
        ? $"{baseUri!.ToString().TrimEnd('/')}/api/archivos/{Model!.ArchivoId}"
        : Url.Content("~/images/logo.png");
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/producto_portada.js" asp-append-version="true"></script>
}

<partial name="_PageHeaderPartial" />

@if (!hasValidProduct)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar la información del producto.
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" title="Cancelar">Cancelar</a>
    </div>
}
else
{
    <form asp-action="Editar"
          asp-route-id="@productoId"
          method="post"
          autocomplete="off">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="card mt-3">
            <div class="row g-0">
                <div class="col-md-4 text-center p-3">
                    <img src="@imageUrl"
                         alt="@productTitle"
                         class="portada img-fluid img-thumbnail producto-form-img"
                         loading="lazy"
                         decoding="async">
                </div>

                <div class="col-md-8">
                    <div class="card-body small">
                        <div class="form-floating mb-3">
                            <input asp-for="ProductoId"
                                   id="ProductoId"
                                   value="@productoId"
                                   placeholder="ProductoId"
                                   readonly
                                   class="form-control-plaintext"
                                   aria-describedby="productoIdHelp" />

                            <label for="ProductoId" class="form-label">
                                @Html.DisplayNameFor(model => model.ProductoId)
                            </label>

                            <div id="productoIdHelp" class="form-text small">
                                Identificador del producto actual.
                            </div>
                        </div>

                        <partial name="_ProductoFormFieldsPartial" model="Model" />
                    </div>
                </div>
            </div>
        </div>

        <partial name="_SaveCancelPartial" />
    </form>
}
