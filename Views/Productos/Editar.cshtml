@model Producto

@{
    ViewData["Title"] = "Productos";
    ViewData["SubTitle"] = "Editar";

    var hasValidProduct = Model is not null && Model.ProductoId > 0;
    var productoId = hasValidProduct ? Model!.ProductoId : 0;

    var configuredUrl = Convert.ToString(ViewBag.Url);
    Uri? baseUri = null;
    var hasValidBaseUrl = Uri.TryCreate(configuredUrl, UriKind.Absolute, out baseUri);

    var hasValidFile = Model?.ArchivoId is > 0;

    var productTitle = string.IsNullOrWhiteSpace(Model?.Titulo)
    ? "Producto actual"
    : Model.Titulo.Trim();

    var imageUrl = hasValidProduct && hasValidFile && hasValidBaseUrl
        ? $"{baseUri!.ToString().TrimEnd('/')}/api/archivos/{Model!.ArchivoId}"
        : Url.Content("~/images/logo.png");
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/producto_portada.js" asp-append-version="true"></script>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item">
            <a class="text-decoration-none"
               title="Regresar al listado"
               asp-action="Index">
                Listado
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            @ViewData["SubTitle"]
        </li>
    </ol>
</nav>

<h2 class="text-center mb-3">
    @ViewData["Title"]
    <small class="text-muted fs-5">@ViewData["SubTitle"]</small>
</h2>

@if (!hasValidProduct)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar la información del producto.
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}
else
{
    <form asp-action="Editar"
          asp-route-id="@productoId"
          method="post"
          autocomplete="off">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="card mt-3">
            <div class="row g-0">
                <div class="col-md-4 text-center p-3">
                    <img src="@imageUrl"
                         alt="@productTitle"
                         class="portada img-fluid img-thumbnail producto-form-img"
                         loading="lazy"
                         decoding="async">
                </div>

                <div class="col-md-8">
                    <div class="card-body small">
                        <div class="form-floating mb-3">
                            <input asp-for="ProductoId"
                                   id="ProductoId"
                                   value="@productoId"
                                   placeholder="ProductoId"
                                   readonly
                                   class="form-control-plaintext"
                                   aria-describedby="productoIdHelp" />

                            <label for="ProductoId" class="form-label">
                                @Html.DisplayNameFor(model => model.ProductoId)
                            </label>

                            <div id="productoIdHelp" class="form-text small">
                                Identificador del producto actual.
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <select asp-for="ArchivoId"
                                    id="ArchivoId"
                                    asp-items="ViewBag.Archivo"
                                    class="form-select"
                                    aria-describedby="archivoHelp">
                                <option value="">Seleccione una imagen</option>
                            </select>

                            <label for="ArchivoId" class="form-label">
                                @Html.DisplayNameFor(model => model.ArchivoId)
                            </label>

                            <span asp-validation-for="ArchivoId" class="text-danger"></span>

                            <div id="archivoHelp" class="form-text small">
                                Seleccione la imagen que representará al producto.
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Titulo"
                                   id="Titulo"
                                   type="text"
                                   placeholder="Título"
                                   class="form-control"
                                   maxlength="120"
                                   aria-describedby="tituloHelp" />

                            <label for="Titulo" class="form-label">
                                @Html.DisplayNameFor(model => model.Titulo)
                            </label>

                            <span asp-validation-for="Titulo" class="text-danger"></span>

                            <div id="tituloHelp" class="form-text small">
                                Ingrese el nombre o título del producto.
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <textarea asp-for="Descripcion"
                                      id="Descripcion"
                                      placeholder="Descripción"
                                      class="form-control producto-textarea"
                                      maxlength="1000"
                                      aria-describedby="descripcionHelp"></textarea>

                            <label for="Descripcion" class="form-label">
                                @Html.DisplayNameFor(model => model.Descripcion)
                            </label>

                            <span asp-validation-for="Descripcion" class="text-danger"></span>

                            <div id="descripcionHelp" class="form-text small">
                                Describa las características principales del producto.
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Precio"
                                   id="Precio"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   inputmode="decimal"
                                   placeholder="Precio"
                                   class="form-control"
                                   aria-describedby="precioHelp" />

                            <label for="Precio" class="form-label">
                                @Html.DisplayNameFor(model => model.Precio)
                            </label>

                            <span asp-validation-for="Precio" class="text-danger"></span>

                            <div id="precioHelp" class="form-text small">
                                Ingrese un precio mayor a cero.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-3">
            <button id="btnEnviar"
                    type="submit"
                    class="btn btn-sm btn-primary">
                Guardar
            </button>

            <a class="btn btn-sm btn-outline-secondary"
               asp-action="Index"
               title="Cancelar">
                Cancelar
            </a>
        </div>
    </form>
}