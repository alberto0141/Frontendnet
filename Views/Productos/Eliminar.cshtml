@model Producto

@{
    ViewData["Title"] = "Productos";
    ViewData["SubTitle"] = "Eliminar";

    var hasValidProduct = Model is not null && Model.ProductoId > 0;
    var productoId = hasValidProduct ? Model!.ProductoId : 0;
    var errorMessage = Convert.ToString(ViewData["ErrorMessage"]);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item">
            <a class="text-decoration-none"
               title="Regresar al listado"
               asp-action="Index">
                Listado
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            @ViewData["SubTitle"]
        </li>
    </ol>
</nav>

<h2 class="text-center mb-3">
    @ViewData["Title"]
    <small class="text-muted fs-5">@ViewData["SubTitle"]</small>
</h2>

@if (!hasValidProduct)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar la información del producto.
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}
else
{
    <div class="alert alert-danger" role="alert">
        ¿Está seguro de que desea eliminar este producto?
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-warning" role="alert">
            @errorMessage
        </div>
    }

    <partial name="_DetallePartial" model="Model" />

    <form asp-action="Eliminar"
          asp-route-id="@productoId"
          method="post"
          autocomplete="off">
        @Html.AntiForgeryToken()

        <div class="text-center mt-3">
            <button id="btnEnviar"
                    type="submit"
                    class="btn btn-sm btn-danger">
                Eliminar
            </button>

            <a class="btn btn-sm btn-outline-secondary"
               asp-action="Index"
               title="Cancelar">
                Cancelar
            </a>
        </div>
    </form>
}