@model Producto

@{
    ViewData["Title"] = "Productos";
    ViewData["SubTitle"] = "Crear";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/producto_portada.js" asp-append-version="true"></script>
}

<partial name="_PageHeaderPartial" />

<form asp-action="Crear"
      method="post"
      autocomplete="off">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="card mt-3">
        <div class="row g-0">
            <div class="col-md-4 text-center p-3">
                <img src="~/images/logo.png"
                     alt="Vista previa del producto"
                     class="portada img-fluid img-thumbnail producto-form-img"
                     loading="lazy"
                     decoding="async">
            </div>

            <div class="col-md-8">
                <div class="card-body small">
                    <partial name="_ProductoFormFieldsPartial" model="Model" />
                </div>
            </div>
        </div>
    </div>

    <partial name="_SaveCancelPartial" />
</form>
