@model ProductoCategoria

@{
    ViewData["Title"] = "Productos";
    ViewData["SubTitle"] = "Remover categoría";

    var hasValidProduct = Model?.Producto is not null && Model.Producto.ProductoId > 0;
    var productoId = hasValidProduct ? Model!.Producto!.ProductoId : 0;

    var hasValidCategory = Model is not null && Model.CategoriaId.HasValue && Model.CategoriaId.Value > 0;
    var categoriaId = hasValidCategory ? Model!.CategoriaId!.Value : 0;

    var categoryName = string.IsNullOrWhiteSpace(Model?.Nombre)
        ? "No disponible"
        : Model.Nombre.Trim();

    var errorMessage = Convert.ToString(ViewData["ErrorMessage"]);
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item">
            <a class="text-decoration-none"
               title="Regresar al listado"
               asp-action="Index">
                Listado
            </a>
        </li>

        <li class="breadcrumb-item">
            @if (hasValidProduct)
            {
                <a class="text-decoration-none"
                   title="Regresar a las categorías"
                   asp-action="Categorias"
                   asp-route-id="@productoId">
                    Categorías
                </a>
            }
            else
            {
                <span>Categorías</span>
            }
        </li>

        <li class="breadcrumb-item active" aria-current="page">
            @ViewData["SubTitle"]
        </li>
    </ol>
</nav>

<h2 class="text-center mb-3">
    @ViewData["Title"]
    <small class="text-muted fs-5">@ViewData["SubTitle"]</small>
</h2>

@if (!hasValidProduct || !hasValidCategory)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar la información para remover la categoría.
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}
else
{
    <h4 class="my-3">Remover categoría</h4>

    <div class="alert alert-danger" role="alert">
        ¿Está seguro de que desea remover este elemento?
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-warning" role="alert">
            @errorMessage
        </div>
    }

    <form asp-action="CategoriasRemover"
          asp-route-id="@productoId"
          asp-route-categoriaId="@categoriaId"
          method="post"
          autocomplete="off">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="card mt-3">
            <div class="card-body small">
                <div class="form-floating mb-3">
                    <input asp-for="CategoriaId"
                           id="CategoriaId"
                           value="@categoriaId"
                           placeholder="CategoriaId"
                           readonly
                           class="form-control-plaintext"
                           aria-describedby="categoriaIdHelp" />

                    <label for="CategoriaId" class="form-label">
                        @Html.DisplayNameFor(model => model.CategoriaId)
                    </label>

                    <div id="categoriaIdHelp" class="form-text small">
                        Identificador de la categoría a remover.
                    </div>
                </div>

                <div class="mb-3 ps-3">
                    <span class="form-label form-text d-block">
                        @Html.DisplayNameFor(model => model.Nombre)
                    </span>

                    <div class="form-text text-body">
                        @categoryName
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-3">
            <button id="btnEnviar"
                    type="submit"
                    class="btn btn-sm btn-danger">
                Remover
            </button>

            <a class="btn btn-sm btn-outline-secondary"
               asp-action="Categorias"
               asp-route-id="@productoId"
               title="Cancelar">
                Cancelar
            </a>
        </div>
    </form>

    <h4 class="my-3">Producto</h4>
    <partial name="_CardPartial" model="Model!.Producto" />
}