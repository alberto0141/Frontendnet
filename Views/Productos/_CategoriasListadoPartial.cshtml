@model Producto

@{
    static string SafeText(string? value, int maxLength = 120)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "No disponible";
        }

        var normalizedValue = value.Trim();

        return normalizedValue.Length > maxLength
            ? $"{normalizedValue[..maxLength]}..."
            : normalizedValue;
    }

    var hasValidProduct = Model is not null && Model.ProductoId > 0;
    var categories = Model?.Categorias?.Where(category => category is not null).ToList() ?? [];
}

@if (!hasValidProduct)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar las categorías del producto.
    </div>
}
else if (categories.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle small">
            <thead>
                <tr>
                    <th scope="col">
                        Id
                    </th>
                    <th scope="col">
                        Nombre
                    </th>
                    <th scope="col">
                        Protegida
                    </th>
                    <th scope="col" class="text-center">
                        Acciones
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var category in categories)
                {
                    var hasValidCategoryId = category.CategoriaId.HasValue && category.CategoriaId.Value > 0;
                    var categoryName = SafeText(category.Nombre);

                    <tr>
                        <td>
                            @(hasValidCategoryId ? category.CategoriaId!.Value.ToString() : "No disponible")
                        </td>

                        <td title="@SafeText(category.Nombre, 500)">
                            @categoryName
                        </td>

                        <td>
                            @if (category.Protegida)
                            {
                                <span class="badge text-bg-warning">
                                    Sí
                                </span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">
                                    No
                                </span>
                            }
                        </td>

                        <td class="text-center">
                            @if (hasValidCategoryId)
                            {
                                <a class="btn btn-sm btn-outline-danger"
                                   asp-action="CategoriasRemover"
                                   asp-route-id="@Model!.ProductoId"
                                   asp-route-categoriaId="@category.CategoriaId!.Value"
                                   title="Remover categoría">
                                    Remover
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Sin acciones
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        Este producto no tiene categorías asignadas.
    </div>
}