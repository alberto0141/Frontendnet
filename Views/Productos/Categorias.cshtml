@model Producto

@{
    ViewData["Title"] = "Productos";
    ViewData["SubTitle"] = "Categorías";

    var hasValidProduct = Model is not null && Model.ProductoId > 0;

    var productTitle = string.IsNullOrWhiteSpace(Model?.Titulo)
        ? "Producto no disponible"
        : Model.Titulo.Trim();
}

<partial name="_PageHeaderPartial" />

@if (!hasValidProduct)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar la información del producto.
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}
else
{
    <div class="card mt-3">
        <div class="card-body small">
            <h3 class="h6 mb-0">
                Categorías asignadas a:
                <span class="fw-semibold">@productTitle</span>
            </h3>
        </div>
    </div>

    <div class="text-end mt-3">
        <a class="btn btn-sm btn-primary"
           asp-action="CategoriasAgregar"
           asp-route-id="@Model!.ProductoId"
           title="Agregar categoría">
            Agregar categoría
        </a>
    </div>

    <div class="mt-3">
        <partial name="_CategoriasListadoPartial" model="Model" />
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}