@using frontendnet.Security
@model IEnumerable<Producto>

@{
    ViewData["Title"] = "Productos";
    ViewData["SubTitle"] = "Listado";

    var productos = Model?.Where(producto => producto is not null).ToList() ?? [];

    var search = Convert.ToString(ViewBag.Search ?? ViewBag.search);

    search = string.IsNullOrWhiteSpace(search)
        ? string.Empty
        : search.Trim();

    var isAdministrator = User.IsInRole(AppRoles.Administrator);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item active" aria-current="page">
            @ViewData["SubTitle"]
        </li>
    </ol>
</nav>

<h2 class="text-center mb-3">
    @ViewData["Title"]
    <small class="text-muted fs-5">@ViewData["SubTitle"]</small>
</h2>

<div class="row small">
    <div class="col-12 col-md-6 mx-auto">
        <form asp-action="Index"
              method="get"
              autocomplete="off">
            <div class="input-group input-group-sm mb-3">
                <input name="s"
                       value="@search"
                       type="search"
                       class="form-control"
                       placeholder="Buscar por título"
                       maxlength="120"
                       aria-label="Buscar productos por título">

                <button class="btn btn-primary"
                        type="submit"
                        title="Buscar">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span class="visually-hidden">Buscar</span>
                </button>
            </div>
        </form>
    </div>
</div>

@if (isAdministrator)
{
    <div class="text-end mb-3">
        <a class="btn btn-sm btn-primary"
           asp-action="Crear"
           title="Crear nuevo producto">
            Crear nuevo
        </a>
    </div>
}

<div class="row small mb-3">
    <div class="col text-end">
        Mostrando @productos.Count elementos
    </div>
</div>

@if (productos.Count > 0)
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in productos)
        {
            <div class="col">
                <partial name="_CardPartial" model="item" />
            </div>
        }
    </div>
}
else
{
    <div class="mt-5">
        <div class="alert alert-warning" role="alert">
            No se encontraron elementos. Inténtelo de nuevo más tarde.
        </div>
    </div>
}