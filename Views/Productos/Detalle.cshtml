@model Producto

@{
    ViewData["Title"] = "Productos";
    ViewData["SubTitle"] = "Detalle";

    static string SafeText(string? value, int maxLength = 160)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "No disponible";
        }

        var normalizedValue = value.Trim();

        return normalizedValue.Length > maxLength
            ? $"{normalizedValue[..maxLength]}..."
            : normalizedValue;
    }

    var hasValidProduct = Model is not null && Model.ProductoId > 0;
    var hasValidFile = Model?.ArchivoId is > 0;

    var title = SafeText(Model?.Titulo, 120);
    var description = SafeText(Model?.Descripcion, 1000);

    var price = Model?.Precio is > 0
        ? Model.Precio.ToString("C")
        : "No disponible";

    var configuredUrl = Convert.ToString(ViewBag.Url);
    Uri? baseUri = null;
    var hasValidBaseUrl = Uri.TryCreate(configuredUrl, UriKind.Absolute, out baseUri);

    var imageUrl = hasValidProduct && hasValidFile && hasValidBaseUrl
        ? $"{baseUri!.ToString().TrimEnd('/')}/api/archivos/{Model!.ArchivoId}"
        : Url.Content("~/images/logo.png");

    var categories = Model?.Categorias?.Where(category => category is not null).ToList() ?? [];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item">
            <a class="text-decoration-none"
               title="Regresar al listado"
               asp-action="Index">
                Listado
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            @ViewData["SubTitle"]
        </li>
    </ol>
</nav>

<h2 class="text-center mb-3">
    @ViewData["Title"]
    <small class="text-muted fs-5">@ViewData["SubTitle"]</small>
</h2>

@if (!hasValidProduct)
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar la información del producto.
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}
else
{
    <div class="card mt-3">
        <div class="row g-0">
            <div class="col-md-4 text-center p-3">
                <img src="@imageUrl"
                     alt="@title"
                     class="img-fluid img-thumbnail producto-form-img"
                     loading="lazy"
                     decoding="async">
            </div>

            <div class="col-md-8">
                <div class="card-body">
                    <div class="mb-3 ps-3">
                        <span class="form-label form-text d-block">
                            @Html.DisplayNameFor(model => model.ProductoId)
                        </span>
                        <div class="form-text text-body">
                            @Model!.ProductoId
                        </div>
                    </div>

                    <div class="mb-3 ps-3">
                        <span class="form-label form-text d-block">
                            @Html.DisplayNameFor(model => model.Titulo)
                        </span>
                        <div class="form-text text-body" title="@SafeText(Model.Titulo, 500)">
                            @title
                        </div>
                    </div>

                    <div class="mb-3 ps-3">
                        <span class="form-label form-text d-block">
                            @Html.DisplayNameFor(model => model.Descripcion)
                        </span>
                        <div class="form-text text-body" title="@SafeText(Model.Descripcion, 1000)">
                            @description
                        </div>
                    </div>

                    <div class="mb-3 ps-3">
                        <span class="form-label form-text d-block">
                            @Html.DisplayNameFor(model => model.Precio)
                        </span>
                        <div class="form-text text-body">
                            @price
                        </div>
                    </div>

                    <div class="mb-3 ps-3">
                        <span class="form-label form-text d-block">
                            Categorías
                        </span>

                        <div class="form-text text-body">
                            @if (categories.Count > 0)
                            {
                                @foreach (var category in categories)
                                {
                                    var categoryName = SafeText(category.Nombre, 50);

                                    <span class="badge rounded-pill text-bg-warning me-1">
                                        @categoryName
                                    </span>
                                }
                            }
                            else
                            {
                                <span>No disponible</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-3">
        <a class="btn btn-sm btn-outline-secondary"
           asp-action="Index"
           title="Cancelar">
            Cancelar
        </a>
    </div>
}