@model Producto

@{
    var hasValidProduct = Model is not null && Model.ProductoId > 0;
}

@if (hasValidProduct)
{
    <div class="card h-100">
        @await Html.PartialAsync("~/Views/Shared/_ProductCardContent.cshtml", Model,
            new ViewDataDictionary(ViewData) { ["ImgClass"] = "comprar-card-img" })

        <div class="card-footer text-center">
            <form asp-controller="Carrito"
                  asp-action="Agregar"
                  asp-route-id="@Model!.ProductoId"
                  method="post"
                  autocomplete="off">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-sm btn-primary">
                    Agregar al carrito
                </button>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        No fue posible cargar este producto.
    </div>
}
